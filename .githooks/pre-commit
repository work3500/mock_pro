#!/usr/bin/env bash
#
# KTNET pre-commit 훅
# ------------------------------------------------------------------
# 커밋 전에 스테이징된 변경 사항을 검사하여, 민감정보(비밀키·토큰·
# 비밀번호 등)가 실수로 저장소에 올라가는 것을 방지합니다.
#
# 설치:  .githooks/install.sh 를 실행하거나
#        git config core.hooksPath .githooks
#
# 임시로 건너뛰기:  SKIP_HOOKS=1 git commit ...  또는  git commit --no-verify
# ------------------------------------------------------------------

set -euo pipefail

# 색상 (터미널이 아닐 경우 비활성화)
if [ -t 1 ]; then
  RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; RESET='\033[0m'
else
  RED=''; YELLOW=''; GREEN=''; RESET=''
fi

# 우회 옵션
if [ "${SKIP_HOOKS:-}" = "1" ]; then
  printf "%bSKIP_HOOKS=1 → pre-commit 검사를 건너뜁니다.%b\n" "$YELLOW" "$RESET"
  exit 0
fi

# 최초 커밋 여부에 따라 비교 대상 결정
if git rev-parse --verify HEAD >/dev/null 2>&1; then
  against=HEAD
else
  against=$(git hash-object -t tree /dev/null)
fi

# 스테이징된 텍스트 파일 목록 (추가/수정된 것만, 삭제 제외)
mapfile -t staged_files < <(git diff --cached --name-only --diff-filter=ACM -z "$against" | tr '\0' '\n')

if [ "${#staged_files[@]}" -eq 0 ]; then
  exit 0
fi

# 민감정보 탐지 패턴 (설명|정규식)
patterns=(
  "AWS 액세스 키|AKIA[0-9A-Z]{16}"
  "개인 키(PEM) 블록|-----BEGIN( RSA| EC| OPENSSH| DSA| PGP)? PRIVATE KEY-----"
  "Slack 토큰|xox[baprs]-[0-9A-Za-z-]{10,}"
  "GitHub 토큰|gh[pousr]_[0-9A-Za-z]{20,}"
  "Google API 키|AIza[0-9A-Za-z_-]{35}"
  "비밀번호/시크릿 하드코딩|(password|passwd|secret|api[_-]?key|token)[[:space:]]*[:=][[:space:]]*['\"][^'\"[:space:]]{6,}['\"]"
)

violations=0

for file in "${staged_files[@]}"; do
  [ -z "$file" ] && continue
  # 바이너리 파일은 건너뜀
  if git diff --cached --numstat -- "$file" | grep -q '^-'; then
    continue
  fi

  # 스테이징된 내용(추가된 라인)만 검사
  added=$(git diff --cached -U0 -- "$file" | grep '^+' | grep -v '^+++' || true)
  [ -z "$added" ] && continue

  for entry in "${patterns[@]}"; do
    desc="${entry%%|*}"
    regex="${entry#*|}"
    if printf '%s\n' "$added" | grep -Eiq -e "$regex"; then
      printf "%b✖ [%s]%b 에서 민감정보로 의심되는 내용이 감지되었습니다: %b%s%b\n" \
        "$RED" "$file" "$RESET" "$YELLOW" "$desc" "$RESET"
      violations=$((violations + 1))
    fi
  done
done

if [ "$violations" -gt 0 ]; then
  printf "\n%b커밋이 차단되었습니다. %d건의 민감정보 의심 항목을 확인하세요.%b\n" "$RED" "$violations" "$RESET"
  printf "오탐이 확실한 경우에만 다음으로 우회할 수 있습니다: %bSKIP_HOOKS=1 git commit ...%b\n" "$YELLOW" "$RESET"
  exit 1
fi

printf "%b✔ pre-commit 검사 통과 (%d개 파일)%b\n" "$GREEN" "${#staged_files[@]}" "$RESET"
exit 0
